# C6 SaaS Core product API base URL (server-side integration target)
# Never put control-plane keys, database URLs, or provider secrets in VITE_ variables.
VITE_C6_SAAS_CORE_URL=

# Legacy PocketBase endpoint retained only for migration/dev compatibility.
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# RemotePay API base URL. No provider secrets belong in VITE_ variables.
VITE_REMOTEPAY_API_URL=
VITE_REMOTEPAY_MERCHANT_ID=
VITE_REMOTEPAY_BRAND_ID=commodity-connect

# Only for controlled development demonstrations. Keep false/absent in production.
VITE_DEMO_MODE=false