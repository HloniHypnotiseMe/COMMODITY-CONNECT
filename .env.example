# C6 SaaS Core product API base URL.
# Browser-safe public endpoint only. Never put control-plane keys, database URLs,
# provider secrets, merchant secrets or signing secrets in VITE_ variables.
VITE_C6_SAAS_CORE_URL=

# Browser-safe, product-scoped capability token. This is NOT a provider secret;
# provider/control-plane/database credentials must remain server-side.
VITE_C6_PRODUCT_KEY=

# Legacy PocketBase endpoint retained only for migration/dev compatibility.
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# No direct RemotePay browser configuration is permitted.
# RemotePay credentials/configuration belong behind C6 SaaS Core.

# Only for controlled development demonstrations. Keep false/absent in production.
VITE_DEMO_MODE=false
