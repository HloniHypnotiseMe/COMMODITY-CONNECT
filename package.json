{
  "name": "commodity-connect",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --pretty false",
    "test:domain": "node --experimental-strip-types tests/domain.test.mjs",
    "test:fire": "node --experimental-strip-types tests/fire.test.mjs",
    "test:agent-company": "node --experimental-strip-types tests/agent-company.test.mjs",
    "test:command-centre": "node --experimental-strip-types tests/command-centre.test.mjs",
    "test:revenue": "node --experimental-strip-types tests/revenue.test.mjs",
    "test:platform": "node --experimental-strip-types tests/platform.test.mjs",
    "test:platform-boundary && npm run test:payment-commission-boundary": "node --experimental-strip-types tests/platform-boundary.test.mjs",
    "test:payment-commission-boundary": "node --experimental-strip-types tests/payment-commission-boundary.test.mjs",
    "test": "npm run test:domain && npm run test:fire && npm run test:agent-company && npm run test:command-centre && npm run test:revenue && npm run test:platform && npm run test:platform-boundary"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
